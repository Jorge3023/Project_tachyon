# Copia este archivo a backend/.env o define estas variables en Render. Todas son opcionales en desarrollo.
# (El detalle de cada una está en el README, sección «Variables de entorno».)

# Cuentas de demostración con contraseñas públicas: SOLO desarrollo local.
SEED_DEMO_USERS=1

# Producción: firma de sesiones (32+ caracteres) y administrador inicial (contraseña de 8+ caracteres).
# SECRET_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ALLOWED_ORIGINS=https://tu-frontend.pages.dev

# Producción: PostgreSQL y almacenamiento de archivos en Supabase. Sin esto se usa SQLite y el disco local.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=datasets

# Ajustes
# DB_POOL_MAX=5
# PARQUET_CACHE_MAX_MB=40
